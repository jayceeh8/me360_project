        "# Step 2: Composite Trapezoid Rule\n",
        "\n",
        "def comp_trap(f, a, b, m=10):\n",
        "    h = (b-a)/m\n",
        "    integral = f(a) + f(b)\n",
        "    for i in range(1, m):\n",
        "        integral += 2*f(a+i*h)\n",
        "    return integral*h/2"
      ],
      "metadata": {
