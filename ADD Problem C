        "mc_errors = []\n",
        "for result in mc_results:\n",
        "    mc_errors.append(abs(result - true_value))\n",
        "\n",
        "mc_result = np.mean(mc_results)\n",
        "mc_error = np.mean(mc_errors)\n"
      ],
