      "source": [
        "num_trials = 100\n",
        "samples = [1e1, 1e2, 1e3, 1e4, 1e5, 1e6]\n",
        "error = []\n",
        "all_errors = []\n",
        "\n",
        "for row in range(num_trials):\n",
        "    for col in samples:\n",
        "        error.append(abs(est_pi(col)-math.pi))\n",
        "    all_errors.append(error)\n",
        "    error = []\n",
        "\n",
        "avg_error = np.mean(all_errors, axis=0)\n",
