    {
      "cell_type": "code",
      "source": [
        "# Step 3: Composite Simpson's Rule\n",
        "\n",
        "def comp_simp(f, a, b, m=10):\n",
        "    h = (b-a)/(2*m)\n",
        "    integral = f(a) + f(b)\n",
        "    for i in range(1, 2*m):\n",
        "        if i % 2 == 1:\n",
        "            integral += 4*f(a+i*h)\n",
        "        else:\n",
        "            integral += 2*f(a+i*h)\n",
        "    return integral*h/3"
      ],
      "metadata": {
