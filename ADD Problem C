      "source": [
        "# Declares functions used for parameter sweep\n",
        "def fun1(x):\n",
        "    return np.sin(x)\n",
        "\n",
        "def fun2(x):\n",
        "    return np.exp(x)\n",
        "\n",
        "def fun3(x):\n",
        "    return np.power(x,2) + 4*x + 4"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 6,
      "id": "cdfda772-6170-4925-9ca4-3000a62ada49",
