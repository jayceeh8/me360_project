      },
      "outputs": [],
      "source": [
        "def mci(f, a, b, N):\n",
        "    x_random = np.random.uniform(a, b, N)\n",
        "    estimate = (b - a) * np.mean(f(x_random))\n",
        "\n",
        "    return estimate"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "74373da7-5b19-4275-b225-293874f2e50a",
      "metadata": {
        "id": "74373da7-5b19-4275-b225-293874f2e50a"
      },
      "outputs": [],
      "source": [
        "def num_samples(f, ground_truth, a, b, tol, max_iter=10e6):\n",
        "    N = 1\n",
        "    while N <= max_iter:\n",
        "        if abs(mci(f, a, b, N) - ground_truth) <= tol:\n",
        "            return N\n",
        "        N += 1\n",
        "    raise ValueError(\"Maximum number of iterations reached before given solution tolerance was achieved\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "4c466bfd-fb2e-4ea1-a67e-96c61c51e658",
      "metadata": {
        "id": "4c466bfd-fb2e-4ea1-a67e-96c61c51e658"
      },
      "outputs": [],
      "source": [
        "num_trials = 100\n",
        "tol = 0.5e-4\n",
        "a = 0\n",
        "b = 1\n",
        "avg_samples = []\n",
        "\n",
        "# Functions for parameter sweep and their ground truth calculations\n",
        "functions = [[fun1, -math.cos(b) + math.cos(a)],\n",
        "             [fun2, math.e**b - math.e**a],\n",
        "             [fun3, (1/3)*b**3 + 2*b**2 + 4*b - ((1/3)*a**3 + 2*a**2 + 4*a)]]\n",
        "\n",
        "for f, truth in functions:\n",
        "    samples = []\n",
        "    for j in range(num_trials):\n",
        "        samples.append(num_samples(f, truth, a, b, tol))\n",
        "    avg_samples.append(np.mean(samples))"
      ]
    },
